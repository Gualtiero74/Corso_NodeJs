extends layouts/main-layout.pug
block style
    link(rel="stylesheet" href="/style/shop.css")
block content
        main
            div
                if users.length > 0
                    each usr in users
                        h1 User: #{usr.user}
                        h2 Pass: #{usr.psw}
                if users.length <= 0
                    h1 Non Ci sono User Collegati


