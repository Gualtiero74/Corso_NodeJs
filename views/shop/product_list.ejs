<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/style/product_list.css">
    <!-- <link rel="stylesheet" href="/style/card-container.css"> -->
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main>
                <div class="d-flex flex-wrap justify-content-center p-5 mt-5">
                    <% if (prod.length> 0) {
                        for (let product of prod) { %>
                        <div class="card p-5 m-2" style="width: 18rem;">

                            <img class="card-img-top" src="<%= product.img %>" alt="Immagine">
                            <div class="card-body">
                                <h1 class="card-title">
                                    <%= product.title %>
                                </h1>
                            </div>
                            <div class="card-body">
                                <a href="/shop/product_detail/<%= product.id %>">Details</a>
                            </div>
                            <div class="card-body">
                                <h1>Price: € <%= product.price %>
                                </h1>
                            </div>
                            <div class="card-body">
                                <%- include('../includes/add_to_cart.ejs',{product:product}) %>
                            </div>
                        </div>
                        <% } %>
                            <% } else { %>
                                <h1>No Product Are Present</h1>
                                <% } %>
                </div>
            </main>
            <%- include('../includes/end.ejs') %>

    </body>

    </html>