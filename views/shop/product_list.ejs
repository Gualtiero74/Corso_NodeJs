<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/style/main.css">
    <link rel="stylesheet" href="/style/footer.css">
    <link rel="stylesheet" href="/style/product_list.css">
    <link rel="stylesheet" href="/style/card-container.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main>
                <div class="card_container">
                    <% if (prod.length> 0) {
                        for (let product of prod) { %>
                        <div class="card">
                            <div class="card_header">
                                <h1> Title: <%= product.title %>
                                </h1>
                            </div>
                            <div class="card_main">
                                <img class="img" src=" <%= product.img %> " alt="Immagine Libro">
                            </div>
                            <div class="card_footer">
                                <div class="div_desc">
                                    <div>
                                    <textarea name="description" id="description">Description: <%= product.description %></textarea>
                                    </div>
                                    <div>
                                        <a class="read_more" href="/shop/product_detail/<%= product.id %>" >Read More...</a>
                                    </div>
                                </div>
                                <div class="div_price">
                                    <h1> Price: € <%= product.price %></h1>
                                <%- include('../includes/add_to_cart.ejs',{product:product}) %>
                                </div>
                            </div>
                        </div>
                
                <% } %>
                    <% } else { %>
                        <h1>No Product Are Present</h1>
                        <% } %>

                </div>
            </main>
            <%- include('../includes/end.ejs') %>

    </body>

    </html>