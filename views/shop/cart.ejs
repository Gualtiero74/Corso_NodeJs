<%- include('../includes/head.ejs') %>
    <!-- <link rel="stylesheet" href="/style/main.css">
    <link rel="stylesheet" href="/style/shop.css">
    <link rel="stylesheet" href="/style/footer.css">
    <link rel="stylesheet" href="/style/cart.css"> -->
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main class="d-flex flex-column align-content-center justify-content-center">
                <div class="d-flex flex-row justify-content-center">
                    <H1>Wish List</H1>
                </div>
                <hr>
                <div class="container-fluid">
                    <% if (prod.length> 0) {
                        for (let product of prod) {
                        %>
                        <div class="container-fluid ">
                            <div class="d-inline-block">
                                <label class="form-label m-0 " for="img"></label>
                                <img src="<%= product.img %>" alt="Immagine" class="vh-15 m-0">
                            </div>

                            <div class="d-inline-block">
                                <label class="form-label m-0" for="quantity">Quantity</label>
                                <input class="form-text m-0" type="text" name="title" value="<%= product.qty %>">
                            </div>

                            <div class="d-inline-block">
                                <label class="form-label m-0" for="id">Id</label>
                                <input class="form-text m-0" type="text" name="id" value="<%= product.id %>">
                            </div>

                            <div class="d-inline-block">
                                <label class="form-label m-0" for="price">Price</label>
                                <input class="form-text m-0" type="text" name="price"
                                    value="<%= product.singlePrice %> ">
                            </div>
                            <form action="/shop/DeleteCart" method="POST" class="d-inline-block">
                                <Button type="submit">Delete</Button>
                                <input type="hidden" name="backId" value="<%= product.id %>">
                                <input type="hidden" name="backPrice" value="<%= product.singlePrice %>">
                            </form>

                        </div>
                        <hr>
                        <% } %>
                            <% } else { %>
                                <h2>No Product Are Present</h2>
                                <% } %>
                                    <div class="d-flex flex-row justify-content-end me-3">
                                        <h2>Total Price: <%= price%>
                                        </h2>
                                    </div>










                </div>

            </main>
            <%- include('../includes/end.ejs') %>
    </body>

    </html>